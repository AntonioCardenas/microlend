---
---

<footer class="mt-20 border-t border-slate-800 bg-[#080c16]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      
      {/* Brand Column */}
      <div class="space-y-4 sm:col-span-2 md:col-span-1">
        <div class="flex items-center space-x-2">
          <div class="w-8 h-8 rounded-lg bg-indigo-950 border border-indigo-700/50 flex items-center justify-center text-indigo-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256">
              <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm40-88a40,40,0,0,1-40,40H112a8,8,0,0,1,0-16h16a24,24,0,0,0,0-48H112a40,40,0,0,1,0-80h16a8,8,0,0,1,0,16H112a24,24,0,0,0,0,48h16A40,40,0,0,1,168,128Z"/>
            </svg>
          </div>
          <span class="text-lg font-bold text-white font-['Syne']">Lending<span class="text-indigo-400">Chain</span></span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Transparent, zero-interest micro-lending on Solana. Connecting global lenders directly with grassroots entrepreneurs.
        </p>
        <div class="text-[11px] text-indigo-300 bg-[#0e1526] p-2.5 rounded-lg border border-slate-800">
          Built for the UN International Day of Charity (September 5)
        </div>
      </div>

      {/* UN Sustainable Development Goals */}
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300">Aligned UN SDGs</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li class="flex items-center space-x-2">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
            <span>SDG 1: No Poverty</span>
          </li>
          <li class="flex items-center space-x-2">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
            <span>SDG 5: Gender Equality</span>
          </li>
          <li class="flex items-center space-x-2">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
            <span>SDG 7: Affordable & Clean Energy</span>
          </li>
          <li class="flex items-center space-x-2">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
            <span>SDG 8: Decent Work & Growth</span>
          </li>
        </ul>
      </div>

      {/* Solana Infrastructure */}
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300">Solana Tech</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li>
            <a href="https://solana.com" target="_blank" rel="noreferrer" class="hover:text-indigo-400 transition-colors py-1 block">
              Solana Web3 Architecture
            </a>
          </li>
          <li>
            <a href="https://explorer.solana.com/?cluster=devnet" target="_blank" rel="noreferrer" class="hover:text-indigo-400 transition-colors py-1 block">
              Solana Devnet Explorer
            </a>
          </li>
          <li>
            <a href="https://spl.solana.com/memo" target="_blank" rel="noreferrer" class="hover:text-indigo-400 transition-colors py-1 block">
              SPL Memo Program
            </a>
          </li>
          <li class="py-1">Avg Network Fee: &lt;$0.001</li>
        </ul>
      </div>

      {/* Quick Links */}
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300">Navigation</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href="/" class="hover:text-indigo-400 transition-colors py-1 block">Explore All Initiatives</a></li>
          <li><a href="/how-it-works" class="hover:text-indigo-400 transition-colors py-1 block">How Micro-Lending Works</a></li>
          <li><a href="/portfolio" class="hover:text-indigo-400 transition-colors py-1 block">Lender Portfolio & Badges</a></li>
          <li><a href="/explorer" class="hover:text-indigo-400 transition-colors py-1 block">Transparency Ledger</a></li>
        </ul>
      </div>

    </div>

    {/* Bottom Bar */}
    <div class="pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 text-center sm:text-left">
      <div>
        <span>In the Spirit of Generosity · 100% of loans directly empower borrowers</span>
      </div>
      <div>
        <span>Powered by Solana Devnet · Zero Platform Take Rates</span>
      </div>
    </div>

  </div>
</footer>
